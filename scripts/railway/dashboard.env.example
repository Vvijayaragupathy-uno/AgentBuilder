# Copy to dashboard.env.local, fill, then link the **dashboard** service:
#   railway service link   # pick aiccoredashboard or your Next.js service
#   python3 scripts/railway/apply_railway_vars.py scripts/railway/dashboard.env.local
#
# Public URL of the Python/Langflow wrapper (no :7860 on Railway):
# NEXT_PUBLIC_AICCORE_API_URL=https://your-backend.up.railway.app
# NEXT_PUBLIC_LANGFLOW_URL=https://your-backend.up.railway.app
#
# Same-origin proxy (optional — see aiccore/README.md):
# AICCORE_UPSTREAM_URL=https://your-backend.up.railway.app
# NEXT_PUBLIC_AICCORE_PROXY_PREFIX=/aiccore-api
