# Copy to backend.env.local (gitignored), fill values, then:
#   railway link   # AgentBuilder / your Python service
#   python3 scripts/railway/apply_railway_vars.py scripts/railway/backend.env.local
#
# Or set in Railway UI → Service → Variables.

# --- Required (production) ---
# LANGFLOW_DATABASE_URL=postgresql://...   # Reference: Langflow Postgres DATABASE_URL
# AICCORE_DATABASE_URL=postgresql://...    # Reference: second Postgres DATABASE_URL

# --- Already common on AgentBuilder image ---
# AICCORE_LANGFLOW_FRONTEND_DIR=/app/langflow-frontend
# AICCORE_BACKEND_ONLY=false

# --- Admin ---
# AICCORE_ADMIN_PASS=your-strong-secret

# --- Optional: multi-worker WebSocket (add Redis plugin, then Reference its URL) ---
# REDIS_URL=${{Redis.REDIS_URL}}
# AICCORE_REDIS_URL=
# AICCORE_REDIS_CHANNEL=aiccore:broadcast

# --- Optional: connection pool (defaults match code if unset) ---
AICCORE_DB_POOL_SIZE=12
AICCORE_DB_MAX_OVERFLOW=24

# --- Optional: workspace snapshot debounce (seconds) ---
# AICCORE_SNAPSHOT_DEBOUNCE_SEC=1.2

# --- Optional: TV demo ceremony phases (when demo gate is open; defaults in code) ---
# AICCORE_DEMO_LINEUP_SECONDS=30   # roster on TV before first / between presenters
# AICCORE_DEMO_PRESENT_SECONDS=180 # full-screen Langflow slot (3 min)
# AICCORE_DEMO_PREP_SECONDS=30     # “next up” prep before the following presenter
# AICCORE_DEMO_SEGMENT_SECONDS=90  # legacy single-segment mode if demo_phase is unset

# --- Optional: CORS / custom domains (comma-separated) ---
# AICCORE_ALLOWED_ORIGINS=https://your-dashboard.up.railway.app

# --- Dangerous (leave unset in prod) ---
# AICCORE_RESET_DB=false
#   Drops only the `aiccore` Postgres schema (sessions, events, submissions, **challenges**, registrations).
#   Use when you want a clean arena DB while Langflow keeps `public`.
# AICCORE_NUCLEAR_RESET_PUBLIC=false
#   Drops Postgres `public` (Langflow) **and** `aiccore` (arena) — same DB full reset. Unset after one boot.
# Optional: after a submitted run, unlock again without reloading last submission into Langflow (default):
# AICCORE_RESTORE_LEGACY_SUBMISSION=false
