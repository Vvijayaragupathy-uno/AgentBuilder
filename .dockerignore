# Version control & OS
.git
.gitignore
.DS_Store

# Python artifacts
__pycache__
*.pyc
*.pyo
*.egg-info
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/

# Node / JS
node_modules/
.npm/

# Environment & IDE
.env
.env.*
.vscode/
.idea/

# ─────────────────────────────────────────────
# Langflow: Dockerfile installs backend from langflow/src/backend/base + src/lfx
# (your patches). Frontend from langflow/src/frontend. Exclude heavy unused trees.
# ─────────────────────────────────────────────
langflow/node_modules/
langflow/**/node_modules/
langflow/src/backend/tests/
langflow/src/backend/langflow/
langflow/src/backend/src/
langflow/docs/
langflow/docker/
langflow/docker_example/
langflow/.devcontainer/
langflow/.github/
langflow/scripts/
langflow/deploy/
langflow/.venv/
langflow/src/frontend/tests/
langflow/src/frontend/.storybook/
langflow/src/frontend/build/
langflow/src/frontend/playwright-report/
langflow/src/frontend/test-results/

# Misc
*.log
.railway/
